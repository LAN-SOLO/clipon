{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clipon",
  "version": "0.1.1",
  "identifier": "com.lan-solo.clipon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "clipon",
        "width": 1000,
        "height": 680,
        "minWidth": 780,
        "minHeight": 520,
        "resizable": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0QjM1OUYwOEZDNjQwNDYKUldSR1FNYVA4Rm16NURXN0NaaEdWSG5mUDNaR1J4SVBWYzdleWN5Vk1QaEwxbWhWQ3JkVFBtNkwK",
      "endpoints": [
        "https://github.com/LAN-SOLO/clipon/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "msi", "nsis", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Clipboard-Manager: Verlauf, Snippets und Paste-Stack, lokal verschlüsselt",
    "longDescription": "clipon merkt sich, was du kopierst — Text und Bilder, durchsuchbar, mit Pins, Snippets und Paste-Stack. Der Verlauf liegt lokal und AES-256-verschlüsselt auf deinem Rechner, der Schlüssel im Schlüsselbund des Systems.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
