{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "clipon windows — least privilege: events/window basics, open/save/confirm dialogs, and opening only the macOS Accessibility settings pane",
  "windows": ["main", "picker"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "x-apple.systempreferences:*" }]
    }
  ]
}
